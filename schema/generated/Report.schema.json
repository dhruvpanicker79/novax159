{
  "type": "object",
  "title": "Report",
  "description": "Top-level export. Deliverable D20, consumed by the dashboard (D21).",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "capture": {
      "anyOf": [
        {
          "$ref": "#/$defs/Capture"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MailSession"
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HostPosture"
      }
    },
    "fleet": {
      "anyOf": [
        {
          "$ref": "#/$defs/FleetPosture"
        },
        {
          "type": "null"
        }
      ]
    },
    "prioritised_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "executive_summary": {
      "type": "string"
    },
    "generated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluation_metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securemailscope/schema/Report.json",
  "$defs": {
    "Capture": {
      "type": "object",
      "title": "Capture",
      "description": "The source artifact. Stage S0.",
      "properties": {
        "path": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer"
        },
        "packet_count": {
          "type": "integer"
        },
        "first_packet_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_packet_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "link_type": {
          "type": "string"
        },
        "analysed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_version": {
          "type": "string"
        }
      }
    },
    "MailSession": {
      "type": "object",
      "title": "MailSession",
      "description": "A flow identified as email, with everything we learned about it.",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "flow": {
          "anyOf": [
            {
              "$ref": "#/$defs/Flow"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol": {
          "$ref": "#/$defs/MailProtocol"
        },
        "protocol_confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "port_role": {
          "$ref": "#/$defs/PortRole"
        },
        "tls_mode": {
          "$ref": "#/$defs/TlsMode"
        },
        "server_host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "server_port": {
          "type": "integer"
        },
        "client_host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "banner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Phase"
          }
        },
        "starttls": {
          "anyOf": [
            {
              "$ref": "#/$defs/StarttlsValidation"
            },
            {
              "type": "null"
            }
          ]
        },
        "handshake": {
          "anyOf": [
            {
              "$ref": "#/$defs/TlsHandshake"
            },
            {
              "type": "null"
            }
          ]
        },
        "certificates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Certificate"
          }
        },
        "chain": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChainResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "attack_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttackEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "features": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeatureVector"
            },
            {
              "type": "null"
            }
          ]
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionAssessment"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      }
    },
    "Flow": {
      "type": "object",
      "title": "Flow",
      "description": "One reconstructed TCP conversation. Stage S1. Deliverable D03.",
      "properties": {
        "stream_id": {
          "type": "integer"
        },
        "src_ip": {
          "type": "string"
        },
        "src_port": {
          "type": "integer"
        },
        "dst_ip": {
          "type": "string"
        },
        "dst_port": {
          "type": "integer"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "packet_count": {
          "type": "integer"
        },
        "c2s_bytes": {
          "type": "integer"
        },
        "s2c_bytes": {
          "type": "integer"
        },
        "byte_to_frame_c2s": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "byte_to_frame_s2c": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "has_gaps": {
          "type": "boolean"
        },
        "retransmission_count": {
          "type": "integer"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      }
    },
    "Evidence": {
      "type": "object",
      "title": "Evidence",
      "description": "Where in the capture this fact came from.",
      "properties": {
        "capture_sha256": {
          "type": "string"
        },
        "stream_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "frame_numbers": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "byte_range": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MailProtocol": {
      "type": "string",
      "enum": [
        "smtp",
        "imap",
        "pop3",
        "unknown"
      ],
      "description": "Application-layer protocol identified at stage S2. Deliverable D01."
    },
    "Confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "confirmed"
      ],
      "description": "How sure we are. Forensic findings report confidence, not certainty."
    },
    "PortRole": {
      "type": "string",
      "enum": [
        "mta_relay",
        "submission",
        "mail_access",
        "unknown"
      ],
      "description": "What the port is *for*, which determines how harshly we judge it."
    },
    "TlsMode": {
      "type": "string",
      "enum": [
        "implicit",
        "starttls",
        "cleartext",
        "unknown"
      ],
      "description": "How (or whether) the session got to TLS."
    },
    "Phase": {
      "type": "object",
      "title": "Phase",
      "description": "A segment of the session's lifetime. Stages S3/S4. Deliverable D02/D03.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PhaseKind"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "byte_range_c2s": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "byte_range_s2c": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      }
    },
    "PhaseKind": {
      "type": "string",
      "enum": [
        "plaintext",
        "starttls_negotiation",
        "encrypted"
      ],
      "description": "A segment of a session's lifetime. Deliverable D02/D03."
    },
    "StarttlsValidation": {
      "type": "object",
      "title": "StarttlsValidation",
      "description": "The ten checks behind deliverable D02.",
      "properties": {
        "v1_advertised": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "v2_capability_mangled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "v3_client_issued": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "v4_server_accepted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "v5_clienthello_followed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "v6_handshake_completed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "v7_ehlo_reissued": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "v8_auth_offered_before_tls": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "v9_credentials_before_tls": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "v10_command_injection": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_capability_line": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      }
    },
    "TlsHandshake": {
      "type": "object",
      "title": "TlsHandshake",
      "description": "Reconstructed handshake. Stage S4. Deliverables D04-D07.",
      "properties": {
        "client_hello": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClientHelloInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "server_hello": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServerHelloInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "negotiated_version": {
          "$ref": "#/$defs/TlsVersion"
        },
        "cipher_suite_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "key_exchange": {
          "$ref": "#/$defs/KeyExchange"
        },
        "key_exchange_bits": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "cipher_bits": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_aead": {
          "type": "boolean"
        },
        "has_forward_secrecy": {
          "type": "boolean"
        },
        "message_sequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completed": {
          "type": "boolean"
        },
        "pq_groups_offered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pq_group_negotiated": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      }
    },
    "ClientHelloInfo": {
      "type": "object",
      "title": "ClientHelloInfo",
      "description": "Parsed ClientHello. Feeds JA3, PQ readiness (USP-05) and the cipher",
      "properties": {
        "legacy_version": {
          "$ref": "#/$defs/TlsVersion"
        },
        "supported_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TlsVersion"
          }
        },
        "cipher_suites": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "cipher_suite_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "supported_groups": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "supported_group_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signature_algorithms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ec_point_formats": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "server_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "alpn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compression_methods": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "fallback_scsv": {
          "type": "boolean"
        },
        "session_ticket_offered": {
          "type": "boolean"
        },
        "ja3": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ja3_string": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      }
    },
    "TlsVersion": {
      "type": "string",
      "enum": [
        "ssl2",
        "ssl3",
        "tls1.0",
        "tls1.1",
        "tls1.2",
        "tls1.3",
        "unknown"
      ],
      "description": "Negotiated TLS version. Deliverable D05."
    },
    "ServerHelloInfo": {
      "type": "object",
      "title": "ServerHelloInfo",
      "description": "Parsed ServerHello.",
      "properties": {
        "legacy_version": {
          "$ref": "#/$defs/TlsVersion"
        },
        "negotiated_version": {
          "$ref": "#/$defs/TlsVersion"
        },
        "cipher_suite": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "cipher_suite_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "selected_group": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_group_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "alpn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "compression_method": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "renegotiation_info": {
          "type": "boolean"
        },
        "session_resumed": {
          "type": "boolean"
        },
        "downgrade_sentinel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ja3s": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ja3s_string": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      }
    },
    "KeyExchange": {
      "type": "string",
      "enum": [
        "rsa",
        "dh",
        "dhe",
        "ecdh",
        "ecdhe",
        "psk",
        "dh_anon",
        "ecdh_anon",
        "tls13_ephemeral",
        "unknown"
      ],
      "description": "Key exchange mechanism. Deliverable D07, feeds Forward Secrecy (D15)."
    },
    "Certificate": {
      "type": "object",
      "title": "Certificate",
      "description": "One X.509 certificate. Stage S5. Deliverables D08, D10-D12.",
      "properties": {
        "chain_position": {
          "type": "integer"
        },
        "subject": {
          "type": "string"
        },
        "subject_cn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer": {
          "type": "string"
        },
        "issuer_cn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "serial_number": {
          "type": "string"
        },
        "not_before": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "not_after": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256_fingerprint": {
          "type": "string"
        },
        "public_key_algorithm": {
          "$ref": "#/$defs/PubKeyAlgorithm"
        },
        "public_key_bits": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature_algorithm": {
          "$ref": "#/$defs/SignatureAlgorithm"
        },
        "subject_alt_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "is_ca": {
          "type": "boolean"
        },
        "is_self_signed": {
          "type": "boolean"
        },
        "key_usage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      }
    },
    "PubKeyAlgorithm": {
      "type": "string",
      "enum": [
        "rsa",
        "ecdsa",
        "ed25519",
        "ed448",
        "dsa",
        "unknown"
      ],
      "description": "Certificate public key algorithm. Deliverable D11."
    },
    "SignatureAlgorithm": {
      "type": "string",
      "enum": [
        "md5WithRSA",
        "sha1WithRSA",
        "sha256WithRSA",
        "sha384WithRSA",
        "sha512WithRSA",
        "rsassaPss",
        "ecdsa-with-SHA1",
        "ecdsa-with-SHA256",
        "ecdsa-with-SHA384",
        "ecdsa-with-SHA512",
        "ed25519",
        "unknown"
      ],
      "description": "Certificate signature algorithm. Deliverable D12."
    },
    "ChainResult": {
      "type": "object",
      "title": "ChainResult",
      "description": "Outcome of passive chain validation. Stage S5. Deliverable D09.",
      "properties": {
        "status": {
